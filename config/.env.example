# F90 prod instance config — copy to config/.env.<name> and fill in. GIT-IGNORED (real secrets).
# scripts/prod-run.sh reads this: the daemon loads it via AUTOSTOCK_ENV_FILE (mounted at /run/account.env),
# and prod-run.sh lifts the AUTOSTOCK_* / account-id / token lines into the container environment.

# ── Account (one daemon per account — never reuse an account across instances) ──
# Option A — F16 account_farm sandbox (recommended for extra instances): a shared key + a distinct
# account id per instance.
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCOUNT_ID=            # DISTINCT per instance (the SR-1 dedup key)
# Option B — a separate Alpaca paper account instead (leave the BROKER_* above blank if so):
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_PAPER=true

# ── Per-instance settings overrides (config.py _apply_env_overrides) ──
AUTOSTOCK_AGGRESSIVENESS=balanced     # conservative | balanced | aggressive  (F85)
AUTOSTOCK_BROKER_PROVIDER=account_farm  # account_farm | alpaca  (overrides settings.yaml broker.provider)

# ── Daemon <-> operator-console shared secret (per instance). If omitted, prod-run.sh derives a
#    deterministic local default (prod-<name>-token). Set explicitly for a non-trivial token. ──
STEERING_OPERATOR_TOKEN=
