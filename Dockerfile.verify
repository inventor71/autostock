# F10 verification-harness image — python + bun + claude CLI toolchain.
# The project CODE is bind-mounted at runtime (see docker-compose.verify.yml), NOT copied in, so we
# always verify the actual worktree. This image only carries the toolchain + third-party deps.
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    BUN_INSTALL=/usr/local/bun \
    PATH=/usr/local/bun/bin:$PATH

# System deps: git (metadata only; code is mounted), curl/unzip (bun), node (claude CLI),
# build-essential (make/g++ for node-gyp — the console pulls native tree-sitter addons).
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl unzip ca-certificates xz-utils build-essential \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Claude Code CLI — the real-LLM path. Auth comes from the host ~/.claude mounted read-only at run.
# node-gyp: npm only BUNDLES node-gyp internally (not exposed as a `node-gyp` binary on PATH); bun's
# native-addon rebuild for the console's tree-sitter addons spawns `node-gyp` from PATH, so a fresh
# `bun install` fails with `spawn node-gyp ENOENT` without this. Installing it globally puts
# /usr/bin/node-gyp on PATH for the non-root runtime user too (paired with build-essential above).
RUN npm install -g @anthropic-ai/claude-code node-gyp && claude --version && node-gyp --version

# bun — for the operator-console submodule typecheck.
RUN curl -fsSL https://bun.sh/install | bash && bun --version

# Python deps only (NOT the package — code is bind-mounted; PYTHONPATH=/app makes the worktree win).
# CPU-only torch keeps the image lean (~hundreds of MB vs multi-GB CUDA). Deps are read straight from
# pyproject.toml so there is no duplicated list; this layer rebuilds only when pyproject changes.
WORKDIR /app
COPY pyproject.toml ./
RUN pip install torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install $(python -c "import tomllib; d=tomllib.load(open('pyproject.toml','rb')); \
print(' '.join(d['project']['dependencies'] + d['project']['optional-dependencies']['dev']))")

# F27: the toolchain above is installed as root (build time), but the container RUNS as the host
# user — docker-compose.verify.yml sets `user: "${DOCKER_UID}:${DOCKER_GID}"`. We deliberately add
# NO `USER` here (the runtime UID is the host's, injected per-run via verify-run.sh), so files the
# container writes onto the bind-mounted worktree are host-owned. HOME is set to /tmp at runtime
# (an arbitrary UID has no passwd entry → ~ would be unwritable /); pre-create /tmp/.claude
# world-writable so the host ~/.claude mount target + claude's writes succeed for any UID.
# (This dir is NOT under the /app bind mount, so the chmod actually sticks — unlike the named
# volume mountpoints, which init-perms chowns at runtime instead.)
RUN mkdir -p /tmp/.claude && chmod 1777 /tmp

ENTRYPOINT ["bash", "scripts/verify.sh"]
