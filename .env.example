# Alpaca Paper Trading API keys (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Alpaca Broker API *sandbox* keys -- for scripts/broker_create_accounts.py and
# the broker_api provider (settings.yaml broker.provider: broker_api).
BROKER_API_KEY=
BROKER_API_SECRET=
# UUID of the sandbox account to trade (from broker_create_accounts.py --list)
BROKER_ACCOUNT_ID=

# LLM API keys (only the provider you use in settings.yaml is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# The "claude_code" provider needs NO key here -- it routes through the local
# `claude` CLI and reuses your Pro/Max subscription login. Just run `claude`
# once and `/login` before starting. Dev/backtest use only.
