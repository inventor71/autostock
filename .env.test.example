# F10 verification harness — TEST environment (copy to .env.test, fill in).
# IMPORTANT: this MUST point at a SEPARATE test paper account, never the production account.
# The verify container sets AUTOSTOCK_ENV_FILE=/app/.env.test so Settings loads THIS file,
# never the production repo-root .env.

# Alpaca PAPER keys for the dedicated TEST account (https://app.alpaca.markets/paper/dashboard)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# LLM: verification uses the REAL claude via the `claude_code` provider, which reuses the host
# ~/.claude subscription login (mounted read-only into the container) — NO key needed here.
# Only set these if a track explicitly switches llm.provider to claude/openai for a test.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
